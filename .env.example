# 运行环境
NODE_ENV=development

# 应用地址
APP_URL=http://localhost:3000

# 数据库连接串（PostgreSQL）
DATABASE_URL=postgresql://app_user:change_me@localhost:5432/digital_hub

# 会话密钥（请替换为足够长的随机字符串，生产环境必改）
SESSION_SECRET=replace_with_a_long_random_secret

# 管理员初始账号（生产环境首次启动后强制修改）
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change_me_before_first_use

# GitHub API Token（P1 指标同步用，MVP 可留空）
GITHUB_TOKEN=
